<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Elite Academic Writers</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--primary:#0a2a6d;--accent:#ff6600;--bg:#f7f9fc;--card:#ffffff;--text:#1f2937;--muted:#6b7280;--success:#16a34a;--error:#dc2626}
    *{box-sizing:border-box} body{margin:0;font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text)}
    header{background:linear-gradient(rgba(10,42,109,.85),rgba(2,6,23,.9)),url("images/student-studying.jpg") center/cover no-repeat;color:#fff;padding:80px 20px;text-align:center} header h1{margin:0;font-size:2.4rem} header p{margin-top:8px}
    nav{background:#020617;display:flex;justify-content:center;gap:22px;padding:14px;flex-wrap:wrap} nav a{color:#c7d2fe;text-decoration:none;font-weight:500} nav a:hover{color:#fff}
    main{max-width:1200px;margin:36px auto;padding:0 20px} section{margin-bottom:40px} .card{background:var(--card);border-radius:14px;padding:28px;box-shadow:0 15px 35px rgba(2,6,23,.08)}
    h2{text-align:left;font-size:1.6rem;margin:0 0 12px} label{display:block;margin-top:10px;font-weight:600} input,button,select,textarea{width:100%;padding:10px;margin-top:6px;border-radius:8px;border:1px solid #e5e7eb;font-family:inherit} button{background:var(--primary);color:#fff;border:none;cursor:pointer} button.secondary{background:var(--accent)} .muted{color:var(--muted);font-size:.95rem} .status{margin-top:8px} .status.success{color:var(--success)} .status.error{color:var(--error)}
    footer{background:#020617;color:#9ca3af;padding:28px 20px;text-align:center;font-size:.9rem} #whatsappFloat{position:fixed;right:18px;bottom:18px;background:#25D366;color:#fff;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 10px 25px rgba(0,0,0,.25);text-decoration:none;z-index:9999}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
  
    /* HERO SECTION */
    #home{margin-bottom:60px}
    .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
    .hero-text h2{font-size:2.2rem;color:var(--primary)}
    .hero-text p{font-size:1.05rem;color:var(--muted);margin:15px 0 25px}
    .hero-btn{display:inline-block;background:var(--accent);color:#fff;padding:14px 26px;border-radius:10px;text-decoration:none;font-weight:600}
    .hero-btn:hover{opacity:.9}
    .hero-images{display:grid;gap:18px}
    .hero-images img{width:100%;border-radius:16px;object-fit:cover;box-shadow:0 12px 30px rgba(0,0,0,.15)}
    @media(max-width:900px){.hero-grid{grid-template-columns:1fr}}

  </style>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-storage-compat.js"></script>
</head>
<body>

<div id="header-placeholder"></div>
<div id="nav-placeholder"></div>
<a href="https://wa.me/254791035489" target="_blank" id="whatsappFloat">💬</a>

<!-- MULTI-PAGE STRUCTURE -->
<div id="pages-container">
  <!-- Page 1: Account -->
  <div class="page" id="page-account">
    <main>
  <!-- HERO SECTION -->
  <section id="home">
    <div class="hero-grid">
      <div class="hero-text">
        <h2>Professional Academic Writing Services</h2>
        <p>Essays, research papers, dissertations, and coursework handled by experienced academic writers. Fast delivery. Confidential. Reliable.</p>
        <a href="#order" class="hero-btn">Place an Order</a>
      </div>
      <div class="hero-images">
        <img src="images/study-desk.jpg" alt="Academic study desk">
        <img src="images/student-studying.jpg" alt="Student studying in library">
      </div>
    </div>
  </section>


      <section id="account">
        <div class="card">
          <h2>Create  Account</h2>
          <div class="grid">
            <div>
              <label for="email">Email</label>
              <input id="email" type="email" placeholder="you@example.com" />
              <label for="password">Password</label>
              <input id="password" type="password" placeholder="Minimum 6 characters" />
              <div style="display:flex;gap:12px;margin-top:12px">
                <button id="registerBtn">Create Account</button>
                <button id="loginBtn" class="secondary">Login</button>
              </div>
              <p id="authMsg" class="muted"></p>
            </div>
            <div>
              <h3 class="muted">New here?</h3>
              <p class="muted">Create an account to place orders, track progress, and communicate with writers.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Page 2: Orders -->
  <div class="page" id="page-order" style="display:none">
    <main>
      <section id="order">
        <div class="card">
          <h2>Place an Order</h2>
          <div class="grid">
            <div>
              <label>Title</label>
              <input id="title" placeholder="Order title" />
              <label>Pages</label>
              <input id="pages" type="number" placeholder="Number of pages" />
              <label>Deadline</label>
              <input id="deadline" type="date" />
            </div>
            <div>
              <label>Upload Instructions</label>
              <input id="file" type="file" />
              <p class="muted">Accepted: PDF, DOCX</p>
              <button id="createOrderBtn">Submit Order</button>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <!-- Page 3: Payment -->
  <div class="page" id="page-payment" style="display:none">
    <main>
      <section id="payment">
        <div class="card">
          <h2>Secure Payment — M-Pesa</h2>
          <label>Phone Number</label>
          <input id="phone" placeholder="07XXXXXXXX or 2547XXXXXXXX" />
          <label>Amount (KES)</label>
          <input id="amount" placeholder="e.g. 2500" />
          <button id="payMpesaBtn">Pay Now</button>
          <p id="mpesaStatus" class="muted"></p>
        </div>
      </section>
    </main>
  </div>

  <!-- Page 4: Writers -->
  <div class="page" id="page-writers" style="display:none">
    <main>
      <section id="writers">
        <div class="card">
          <h2>Work With Us — Writers</h2>
          <label>Full Name</label><input id="wName" />
          <label>Email</label><input id="wEmail" />
          <label>Subjects</label><input id="wSubjects" placeholder="e.g. Economics, Nursing" />
          <label>Sample (PDF/DOC)</label><input type="file" id="wSample" />
          <button id="applyWriterBtn">Apply as Writer</button>
          <p id="writerMsg" class="muted"></p>
        </div>
      </section>
    </main>
  </div>

  <!-- Page 5: Legal -->
  <div class="page" id="page-legal" style="display:none">
    <main>
      <section id="legal">
        <div class="card">
          <h2>Privacy Policy</h2>
          <p>Your privacy is important. Client and writer data is stored securely and never shared without consent.</p>
          <h2>Terms of Service</h2>
          <p>By using our services, you agree to provide accurate info and pay as agreed. Refunds and order changes follow our policies.</p>
          <h2>Compliance</h2>
          <p>Services comply with academic integrity. Clients and writers are responsible for ethical use of content.</p>
        </div>
      </section>
    </main>
  </div>
</div>

<div id="footer-placeholder"></div>

<script>
  const headerHTML = `<header>
    <h1>Elite Academic Writers</h1>
    <p>Professional academic writing services — essays, research papers, theses, and dissertations delivered on time.</p>
    <p style="margin-top:12px;font-weight:600">📞 Call / WhatsApp: <a href='tel:+254791035489' style='color:#c7d2fe;text-decoration:none'>+254 791 035 489</a> | <a href='https://wa.me/254791035489' target='_blank' style='color:#c7d2fe;text-decoration:none'>Chat on WhatsApp</a></p>  
</header>`;

  const navHTML = `<nav>
    <a href='#page-account' onclick='showPage("page-account")'>Account</a>
    <a href='#page-order' onclick='showPage("page-order")'>Order</a>
    <a href='#page-payment' onclick='showPage("page-payment")'>Payment</a>
    <a href='#page-writers' onclick='showPage("page-writers")'>Writers</a>
    <a href='#page-legal' onclick='showPage("page-legal")'>Legal</a>
  </nav>`;

  const footerHTML = `<footer>
    <p>© 2025 Elite Academic Writers. All rights reserved.</p>
    <p>📞 Call / WhatsApp: +254 791 035 489</p>
    <p>Charles Karimi</p>
  </footer>`;

  document.getElementById('header-placeholder').innerHTML = headerHTML;
  document.getElementById('nav-placeholder').innerHTML = navHTML;
  document.getElementById('footer-placeholder').innerHTML = footerHTML;

  function showPage(pageId){
    document.querySelectorAll('.page').forEach(p=>p.style.display='none');
    document.getElementById(pageId).style.display='block';
    window.scrollTo(0,0);
  }
</script>

</body>
</html>
